{
  "name": "css-invest-backend",
  "version": "1.0.0",
  "description": "CSS Invest - NAV-based Managed Investment Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run start:runtime",
    "start:runtime": "node src/server.js",
    "dev": "nodemon src/server.js",
    "frontend:dev": "cd frontend && npm run dev:solo",
    "frontend:stack": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"npm run frontend:dev\"",
    "website:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-website.ps1",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:setup": "npm run migrate && npm run seed",
    "test": "jest --coverage",
    "cashflow:evaluate:agent-mcp": "node scripts/evaluate-agent-cashflow-mcp.js",
    "cashflow:evaluate:mapping": "node scripts/evaluate-cashflow-mapping.js",
    "cashflow:evaluate:testing-template-2": "node scripts/evaluate-testing-template-2-adversarial.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "fintech",
    "investment",
    "nav",
    "portfolio",
    "managed-funds"
  ],
  "author": "CSS Invest",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.2",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.7.1",
    "sequelize": "^6.37.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
